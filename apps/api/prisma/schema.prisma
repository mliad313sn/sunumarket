// SunuMarket schema — Phase 2 (ERD: docs/ERD.md).
// Money is always BigInt minor units + ISO currency (DC-5).
// PostGIS geometry via Unsupported(); geo queries use raw SQL.
// Append-only tables (immutability triggers in migration): ledger_entries,
// rider_cash_ledger, settlement_lines, fraud_events, audit_log.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ── Identity, auth, KYC, fraud ───────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String   @unique
  name          String?
  locale        String   @default("fr")
  country       String   @db.Char(2)
  kycTier       Int      @default(0) @map("kyc_tier")
  payoutPinHash String?  @map("payout_pin_hash")
  roles         String[] @default(["buyer"])
  createdAt     DateTime @default(now()) @map("created_at")

  devices        DeviceBinding[]
  kycRecords     KycRecord[]
  shops          Shop[]
  deliveryPoints DeliveryPoint[]
  orders         Order[]
  rider          Rider?
  fraudEvents    FraudEvent[]
  refreshTokens  RefreshToken[]
  educationCards EducationCardState[]

  @@map("users")
}

model DeviceBinding {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceHash   String    @map("device_hash")
  trusted      Boolean   @default(false)
  firstSeen    DateTime  @default(now()) @map("first_seen")
  lastVerified DateTime? @map("last_verified")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceHash])
  @@map("device_bindings")
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceHash String   @map("device_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  rotatedTo String?   @map("rotated_to") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model KycRecord {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tier       Int
  status     String    @default("pending") // pending|approved|rejected
  documents  Json      @default("{}")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("kyc_records")
}

model FraudEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  deviceHash   String?  @map("device_hash")
  kind         String
  detail       Json     @default("{}")
  reviewStatus String   @default("open") @map("review_status") // open|cleared|actioned
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([kind, reviewStatus])
  @@map("fraud_events")
}

model EducationCardState {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  card   String // seller_scam_warning | rider_counterfeit_cash
  seenAt DateTime @default(now()) @map("seen_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, card])
  @@map("education_card_state")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

model City {
  id      String @id @default(uuid()) @db.Uuid
  country String @db.Char(2)
  name    String

  zones Zone[]
  shops Shop[]

  @@unique([country, name])
  @@map("cities")
}

model Shop {
  id              String  @id @default(uuid()) @db.Uuid
  sellerId        String  @map("seller_id") @db.Uuid
  slug            String  @unique
  name            String
  description     String?
  country         String  @db.Char(2)
  cityId          String  @map("city_id") @db.Uuid
  whatsappPhone   String? @map("whatsapp_phone")
  verified        Boolean @default(false)
  completedOrders Int     @default(0) @map("completed_orders")
  enabledMethods  String[] @default([]) @map("enabled_methods")
  createdAt       DateTime @default(now()) @map("created_at")

  seller   User      @relation(fields: [sellerId], references: [id])
  city     City      @relation(fields: [cityId], references: [id])
  products Product[]
  orders   Order[]

  @@map("shops")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  title       String
  description String?
  priceMinor  BigInt   @map("price_minor")
  currency    String   @db.Char(3)
  stock       Int
  status      String   @default("active") // draft|active|archived
  images      Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  shop       Shop        @relation(fields: [shopId], references: [id])
  orderItems OrderItem[]

  @@index([shopId, status])
  @@map("products")
}

// ── Geo ──────────────────────────────────────────────────────────────────────

model Zone {
  id      String                                    @id @default(uuid()) @db.Uuid
  cityId  String                                    @map("city_id") @db.Uuid
  name    String
  band    Int
  feeMinor BigInt                                   @map("fee_minor")
  currency String                                   @db.Char(3)
  polygon Unsupported("geometry(Polygon, 4326)")

  city City @relation(fields: [cityId], references: [id])

  @@map("zones")
}

model DeliveryPoint {
  id            String                                 @id @default(uuid()) @db.Uuid
  ownerId       String?                                @map("owner_id") @db.Uuid
  label         String?
  landmark      String
  point         Unsupported("geometry(Point, 4326)")
  consent       Boolean                                @default(false)
  truncateAfter DateTime?                              @map("truncate_after")
  createdAt     DateTime                               @default(now()) @map("created_at")

  owner User? @relation(fields: [ownerId], references: [id])

  @@map("delivery_points")
}

// ── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                    String    @id @default(uuid()) @db.Uuid
  shopId                String    @map("shop_id") @db.Uuid
  buyerId               String?   @map("buyer_id") @db.Uuid
  guestPhone            String?   @map("guest_phone")
  status                String    @default("created")
  subtotalMinor         BigInt    @map("subtotal_minor")
  deliveryFeeMinor      BigInt    @map("delivery_fee_minor")
  totalMinor            BigInt    @map("total_minor")
  currency              String    @db.Char(3)
  deliveryPointSnapshot Json      @map("delivery_point_snapshot")
  idempotencyKey        String    @unique @map("idempotency_key")
  trackingToken         String    @unique @map("tracking_token")
  paymentExpiresAt      DateTime? @map("payment_expires_at")
  stockRestored         Boolean   @default(false) @map("stock_restored")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  shop     Shop             @relation(fields: [shopId], references: [id])
  buyer    User?            @relation(fields: [buyerId], references: [id])
  items    OrderItem[]
  attempts PaymentAttempt[]
  job      DeliveryJob?
  ratings  Rating[]
  dispute  Dispute?

  @@index([shopId, status])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  titleSnapshot  String @map("title_snapshot")
  qty            Int
  unitPriceMinor BigInt @map("unit_price_minor")
  currency       String @db.Char(3)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ── Payments ─────────────────────────────────────────────────────────────────

model PaymentProvider {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique // AGG_A|AGG_B|PISPI|MOCK
  kind   String
  config Json    @default("{}")
  active Boolean @default(true)

  attempts          PaymentAttempt[]
  webhookEvents     WebhookEvent[]
  settlementBatches SettlementBatch[]

  @@map("payment_providers")
}

model PaymentAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  method        String
  providerId    String?  @map("provider_id") @db.Uuid
  status        String   @default("initiated")
  providerRef   String?  @unique @map("provider_ref")
  failureReason String?  @map("failure_reason")
  idempotencyKey String  @unique @map("idempotency_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order       Order              @relation(fields: [orderId], references: [id])
  provider    PaymentProvider?   @relation(fields: [providerId], references: [id])
  transaction LedgerTransaction?

  @@index([orderId, status])
  @@map("payment_attempts")
}

model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  eventId        String   @map("event_id")
  payload        Json
  signatureValid Boolean  @map("signature_valid")
  outcome        String // applied|duplicate|rejected|late
  receivedAt     DateTime @default(now()) @map("received_at")

  provider PaymentProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, eventId])
  @@map("webhook_events")
}

// ── Ledger ───────────────────────────────────────────────────────────────────

model LedgerAccount {
  id        String @id @default(uuid()) @db.Uuid
  ownerType String @map("owner_type") // platform|seller|rider|provider|buyer_refund|tax
  ownerId   String? @map("owner_id") @db.Uuid
  currency  String @db.Char(3)

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, currency])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String // sale|refund|payout|remittance|fee|adjustment
  attemptId String?  @unique @map("attempt_id") @db.Uuid
  sourceRef String?  @map("source_ref")
  createdAt DateTime @default(now()) @map("created_at")

  attempt         PaymentAttempt?  @relation(fields: [attemptId], references: [id])
  entries         LedgerEntry[]
  settlementLines SettlementLine[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  amountMinor   BigInt   @map("amount_minor") // sign = direction; Σ per txn = 0
  currency      String   @db.Char(3)
  leg           String // gross|provider_fee|tax|net|cod_cash
  createdAt     DateTime @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("ledger_entries")
}

model Payout {
  id          String   @id @default(uuid()) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)
  rail        String // PI_SPI|AGGREGATOR
  status      String   @default("requested")
  pinVerified Boolean  @default(false) @map("pin_verified")
  idempotencyKey String @unique @map("idempotency_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payouts")
}

// ── Settlement & reconciliation ──────────────────────────────────────────────

model SettlementBatch {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  settlementDate DateTime @map("settlement_date") @db.Date
  sourceFile     String   @map("source_file")
  status         String   @default("ingested") // ingested|matched|closed
  createdAt      DateTime @default(now()) @map("created_at")

  provider PaymentProvider  @relation(fields: [providerId], references: [id])
  lines    SettlementLine[]

  @@unique([providerId, settlementDate, sourceFile])
  @@map("settlement_batches")
}

model SettlementLine {
  id                   String  @id @default(uuid()) @db.Uuid
  batchId              String  @map("batch_id") @db.Uuid
  providerRef          String  @map("provider_ref")
  amountMinor          BigInt  @map("amount_minor")
  feeMinor             BigInt  @default(0) @map("fee_minor")
  currency             String  @db.Char(3)
  matchedTransactionId String? @map("matched_transaction_id") @db.Uuid
  matchKind            String  @default("unmatched") @map("match_kind") // exact|fuzzy|unmatched

  batch              SettlementBatch     @relation(fields: [batchId], references: [id])
  matchedTransaction LedgerTransaction?  @relation(fields: [matchedTransactionId], references: [id])
  flags              ReconciliationFlag[]

  @@map("settlement_lines")
}

model ReconciliationFlag {
  id               String    @id @default(uuid()) @db.Uuid
  settlementLineId String?   @map("settlement_line_id") @db.Uuid
  orderId          String?   @map("order_id") @db.Uuid
  kind             String // unmatched_line|missing_order|amount_mismatch
  status           String    @default("open") // open|resolved
  openedAt         DateTime  @default(now()) @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")

  settlementLine SettlementLine? @relation(fields: [settlementLineId], references: [id])

  @@index([status, openedAt])
  @@map("reconciliation_flags")
}

// ── Delivery network ─────────────────────────────────────────────────────────

model Rider {
  userId                String  @id @map("user_id") @db.Uuid
  vehicle               String?
  active                Boolean @default(true)
  codOutstandingMinor   BigInt  @default(0) @map("cod_outstanding_minor") // cache; source of truth = rider_cash_ledger

  user       User              @relation(fields: [userId], references: [id])
  jobs       DeliveryJob[]
  offers     DispatchOffer[]
  cashLedger RiderCashLedger[]

  @@map("riders")
}

model Partner {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  adapter          String  @default("MOCK")
  webhookSecretRef String  @map("webhook_secret_ref")
  contactUserId    String? @map("contact_user_id") @db.Uuid

  jobs DeliveryJob[]

  @@map("partners")
}

model DeliveryJob {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  mode           String // SELF|RIDER|PARTNER
  status         String   @default("requested")
  riderId        String?  @map("rider_id") @db.Uuid
  partnerId      String?  @map("partner_id") @db.Uuid
  feeMinor       BigInt   @map("fee_minor")
  currency       String   @db.Char(3)
  cod            Boolean  @default(false)
  codAmountMinor BigInt?  @map("cod_amount_minor")
  proof          Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id])
  rider   Rider?         @relation(fields: [riderId], references: [userId])
  partner Partner?       @relation(fields: [partnerId], references: [id])
  offers  DispatchOffer[]
  events  JobEvent[]

  @@index([status])
  @@map("delivery_jobs")
}

model DispatchOffer {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  riderId   String   @map("rider_id") @db.Uuid
  offeredAt DateTime @default(now()) @map("offered_at")
  response  String   @default("pending") // pending|accepted|rejected|expired

  job   DeliveryJob @relation(fields: [jobId], references: [id])
  rider Rider       @relation(fields: [riderId], references: [userId])

  @@unique([jobId, riderId])
  @@map("dispatch_offers")
}

model JobEvent {
  id       String                                @id @default(uuid()) @db.Uuid
  jobId    String                                @map("job_id") @db.Uuid
  eventId  String                                @map("event_id") // client uuid — offline sync dedupe
  status   String
  gps      Unsupported("geometry(Point, 4326)")?
  at       DateTime

  job DeliveryJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, eventId])
  @@map("job_events")
}

model RiderCashLedger {
  id          String   @id @default(uuid()) @db.Uuid
  riderId     String   @map("rider_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor") // collected(+) remitted(-)
  currency    String   @db.Char(3)
  kind        String // cod_collected|remitted_pispi|remitted_agent
  createdAt   DateTime @default(now()) @map("created_at")

  rider Rider @relation(fields: [riderId], references: [userId])

  @@map("rider_cash_ledger")
}

// ── Trust, moderation, admin ─────────────────────────────────────────────────

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  target    String // seller|rider|partner
  stars     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, target])
  @@map("ratings")
}

model Dispute {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  status       String    @default("open") // open|resolved_refund|resolved_reject
  reason       String
  payoutFrozen Boolean   @default(true) @map("payout_frozen")
  evidence     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("disputes")
}

model CountryPackRecord {
  id      String  @id @default(uuid()) @db.Uuid
  country String  @unique @db.Char(2)
  version Int
  pack    Json
  active  Boolean @default(true)

  @@map("country_packs")
}

model AuditLog {
  id      String   @id @default(uuid()) @db.Uuid
  actorId String?  @map("actor_id") @db.Uuid
  action  String
  detail  Json     @default("{}")
  at      DateTime @default(now())

  @@map("audit_log")
}

model SmsOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String
  body      String
  senderId  String    @map("sender_id")
  status    String    @default("queued") // queued|sent|failed
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@map("sms_outbox")
}
